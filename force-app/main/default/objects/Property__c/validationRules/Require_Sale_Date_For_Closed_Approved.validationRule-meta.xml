<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Sale_Date_For_Closed_Approved</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;Closed Approved&quot;),
    ISBLANK(Sale_Date__c)
)</errorConditionFormula>
    <errorDisplayField>Sale_Date__c</errorDisplayField>
    <errorMessage>Enter the sale date before closing the property as approved.</errorMessage>
</ValidationRule>
